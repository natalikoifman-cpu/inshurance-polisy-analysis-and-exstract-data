{
  "swagger": "2.0",
  "info": {
    "title": "Agent Skills Pipeline",
    "description": "General-purpose skills for building reliable chat agents (sales, marketing, customer service). Implements the engineered-agent pipeline: intake form check, deterministic routing, smart retrieval (keyword enrichment + BM25), grounded answers, and consistency verification. The model is the last station, not the first.",
    "version": "1.0.0",
    "contact": {
      "name": "Insurance Policy Analysis Team"
    }
  },
  "host": "REPLACE-WITH-YOUR-FUNCTION-APP.azurewebsites.net",
  "basePath": "/api",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "header",
      "name": "x-functions-key"
    }
  },
  "security": [{"api_key": []}],
  "paths": {
    "/skills": {
      "get": {
        "operationId": "ListSkills",
        "summary": "List agent skills",
        "x-ms-summary": "List agent skills",
        "description": "Returns the playbook of the eight agent-building skills and which connector action implements each one. Use to explain to a maker or an agent what capabilities are available.",
        "responses": {
          "200": {
            "description": "The skill playbook",
            "schema": {
              "type": "object",
              "properties": {
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {"type": "integer"},
                      "name": {"type": "string"},
                      "action": {"type": "string"},
                      "rule": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/intake/check": {
      "post": {
        "operationId": "CheckIntakeForm",
        "summary": "Check intake form",
        "x-ms-summary": "Check intake form",
        "description": "Skill 1: fills the intake form from the conversation and reports whether it is complete. Call this BEFORE answering any customer request. If 'complete' is false, ask the user the returned 'next_question' and call again — never guess a missing field.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "conversation_text": {
                  "type": "string",
                  "description": "Everything the user wrote so far in this conversation",
                  "x-ms-summary": "Conversation text"
                },
                "known_fields": {
                  "type": "object",
                  "description": "Fields already confirmed in earlier turns, e.g. {\"topic\": \"claim\"}",
                  "x-ms-summary": "Known fields"
                },
                "required_fields": {
                  "type": "array",
                  "description": "Optional custom field definitions; defaults to the standard 5-field insurance intake form",
                  "x-ms-summary": "Required fields",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {"type": "string"},
                      "question": {"type": "string", "description": "The question to ask when this field is missing"},
                      "description": {"type": "string"},
                      "allowed": {"type": "array", "items": {"type": "string"}}
                    }
                  }
                }
              },
              "required": ["conversation_text"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form status",
            "schema": {
              "type": "object",
              "properties": {
                "complete": {"type": "boolean", "x-ms-summary": "Form complete"},
                "filled": {"type": "object", "x-ms-summary": "Filled fields"},
                "missing": {"type": "array", "items": {"type": "string"}, "x-ms-summary": "Missing fields"},
                "invalid": {"type": "array", "items": {"type": "object"}, "x-ms-summary": "Invalid fields"},
                "next_question": {"type": "string", "x-ms-summary": "Next question to ask"}
              }
            }
          }
        }
      }
    },
    "/route": {
      "post": {
        "operationId": "RouteRequest",
        "summary": "Route request by rules",
        "x-ms-summary": "Route request by rules",
        "description": "Skill 3: deterministic routing. Given the completed intake fields and a list of rules, returns which business flow to follow. The same input always returns the same route — the AI must follow the returned route, never pick a branch itself.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "object",
                  "description": "The completed intake form, e.g. {\"topic\": \"claim\", \"product\": \"car\"}",
                  "x-ms-summary": "Intake fields"
                },
                "rules": {
                  "type": "array",
                  "description": "Ordered rules; first full match wins. Empty 'when' = catch-all. Ops: eq, ne, in, contains, gt, lt",
                  "x-ms-summary": "Routing rules",
                  "items": {
                    "type": "object",
                    "properties": {
                      "when": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "field": {"type": "string"},
                            "op": {"type": "string", "enum": ["eq", "ne", "in", "contains", "gt", "lt"]},
                            "value": {}
                          }
                        }
                      },
                      "route": {"type": "string"}
                    }
                  }
                }
              },
              "required": ["fields", "rules"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The selected route",
            "schema": {
              "type": "object",
              "properties": {
                "route": {"type": "string", "x-ms-summary": "Selected route"},
                "rule_index": {"type": "integer"},
                "matched_conditions": {"type": "array", "items": {"type": "object"}}
              }
            }
          }
        }
      }
    },
    "/retrieve": {
      "post": {
        "operationId": "RetrieveParagraphs",
        "summary": "Retrieve relevant paragraphs",
        "x-ms-summary": "Retrieve relevant paragraphs",
        "description": "Skill 4: the smart-retrieval funnel. Enriches the question's keywords in code (Hebrew prefixes, plural/singular, synonyms) and runs BM25 ranking to return only the 7-8 most relevant paragraphs from a document. Call this INSTEAD of pasting a whole document to the model. Then answer only from the returned paragraphs.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "question": {"type": "string", "description": "The customer's question", "x-ms-summary": "Question"},
                "document_text": {"type": "string", "description": "The full text of the document/data to search in", "x-ms-summary": "Document text"},
                "top_k": {"type": "integer", "default": 8, "description": "How many paragraphs to return (default 8)", "x-ms-summary": "Top K"},
                "synonyms": {
                  "type": "object",
                  "description": "Domain synonyms, e.g. {\"רכב\": [\"אוטו\", \"מכונית\"]}",
                  "x-ms-summary": "Synonyms"
                }
              },
              "required": ["question", "document_text"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Top relevant paragraphs",
            "schema": {
              "type": "object",
              "properties": {
                "found": {"type": "boolean", "x-ms-summary": "Anything found"},
                "total_paragraphs": {"type": "integer"},
                "keywords_used": {"type": "array", "items": {"type": "string"}},
                "paragraphs": {
                  "type": "array",
                  "x-ms-summary": "Relevant paragraphs",
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {"type": "integer"},
                      "score": {"type": "number"},
                      "text": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/answer": {
      "post": {
        "operationId": "GroundedAnswer",
        "summary": "Grounded answer",
        "x-ms-summary": "Grounded answer",
        "description": "Skill 5: answers the question using ONLY the supplied paragraphs (typically the output of RetrieveParagraphs). Refuses to invent facts; says 'not found' when the answer is not in the text. Use this for the final customer-facing answer to any document/data question.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "question": {"type": "string", "x-ms-summary": "Question"},
                "paragraphs": {"type": "array", "items": {"type": "string"}, "description": "The retrieved paragraphs — the ONLY source the answer may use", "x-ms-summary": "Paragraphs"},
                "language": {"type": "string", "default": "he", "description": "Answer language: he or en", "x-ms-summary": "Language"},
                "extra_instructions": {"type": "string", "description": "Optional role-specific instructions (tone, format)", "x-ms-summary": "Extra instructions"}
              },
              "required": ["question", "paragraphs"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The grounded answer",
            "schema": {
              "type": "object",
              "properties": {
                "answer": {"type": "string", "x-ms-summary": "Answer"},
                "paragraphs_used": {"type": "integer"}
              }
            }
          }
        }
      }
    },
    "/verify": {
      "post": {
        "operationId": "VerifyConsistency",
        "summary": "Verify answer consistency",
        "x-ms-summary": "Verify answer consistency",
        "description": "Skill 5 proof: runs the same grounded answer twice and compares. 'consistent' = true means the input is precise and nothing is being guessed. Use when testing an agent or before sending high-stakes answers.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "question": {"type": "string", "x-ms-summary": "Question"},
                "paragraphs": {"type": "array", "items": {"type": "string"}, "x-ms-summary": "Paragraphs"},
                "language": {"type": "string", "default": "he", "x-ms-summary": "Language"}
              },
              "required": ["question", "paragraphs"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consistency result",
            "schema": {
              "type": "object",
              "properties": {
                "consistent": {"type": "boolean", "x-ms-summary": "Consistent"},
                "answer_1": {"type": "string"},
                "answer_2": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "operationId": "AskPipeline",
        "summary": "Ask (full pipeline)",
        "x-ms-summary": "Ask (full pipeline)",
        "description": "The whole engineered pipeline in one call: optional intake gate, then retrieval funnel, then grounded answer. Returns status 'need_more_info' with the next question, 'not_found', or 'answered'. Simplest way to use the connector from a Copilot Studio agent.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "question": {"type": "string", "x-ms-summary": "Question"},
                "document_text": {"type": "string", "x-ms-summary": "Document text"},
                "known_fields": {"type": "object", "x-ms-summary": "Known intake fields"},
                "required_fields": {"type": "array", "items": {"type": "object"}, "description": "Optional intake gate; omit to skip the intake check", "x-ms-summary": "Required fields"},
                "top_k": {"type": "integer", "default": 8, "x-ms-summary": "Top K"},
                "synonyms": {"type": "object", "x-ms-summary": "Synonyms"},
                "language": {"type": "string", "default": "he", "x-ms-summary": "Language"}
              },
              "required": ["question", "document_text"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pipeline result",
            "schema": {
              "type": "object",
              "properties": {
                "status": {"type": "string", "description": "answered / need_more_info / not_found", "x-ms-summary": "Status"},
                "answer": {"type": "string", "x-ms-summary": "Answer"},
                "intake": {"type": "object", "x-ms-summary": "Intake status"},
                "retrieval": {"type": "object", "x-ms-summary": "Retrieval details"}
              }
            }
          }
        }
      }
    }
  }
}
